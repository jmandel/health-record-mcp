# PostgreSQL Database Configuration
# Copy this file to .env and update with your actual credentials

# PostgreSQL Connection String
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://localhost:5432/family_ehr

# Alternative: Separate connection parameters
# (Used if DATABASE_URL is not set)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=family_ehr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Optional: SSL/TLS Configuration
# POSTGRES_SSL=true
# POSTGRES_SSL_CA=/path/to/ca-certificate.crt

# Default Import Settings
# These can be overridden with command-line arguments

# Default source database/JSON file path
# Supports both .json (ClientFullEHR format, recommended) and .sqlite (legacy)
DEFAULT_SOURCE_DB=./data/my_record.json

# Default patient information
# Leave empty to require on command line
DEFAULT_PATIENT_FIRST_NAME=
DEFAULT_PATIENT_LAST_NAME=

# Default provider name
# Leave empty to require on command line
DEFAULT_PROVIDER_NAME=

# API Configuration (for REST API server)
API_PORT=8443
API_HOST=localhost
API_BEARER_TOKEN=

# Static Session Configuration (for development)
STATIC_SESSION_ENABLED=true
STATIC_SESSION_DB_PATH=./data/my_record.sqlite
